---
// CookieConsent.astro
---

<div id="cookie-banner" class="fixed bottom-4 right-4 sm:bottom-6 sm:right-6 max-w-sm w-[calc(100%-2rem)] p-6 bg-[#0a0a0a]/80 backdrop-blur-xl border border-white/10 rounded-2xl shadow-2xl z-50 transform transition-all duration-500 translate-y-8 opacity-0 pointer-events-none hidden" aria-live="polite">
  <div class="flex flex-col gap-4">
    <div class="flex items-start gap-3">
      <div class="p-2 bg-primary/20 rounded-full text-primary shrink-0">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 2a10 10 0 1 0 10 10 4 4 0 0 1-5-5 4 4 0 0 1-5-5"></path>
          <path d="M8.5 8.5v.01"></path>
          <path d="M16 12.5v.01"></path>
          <path d="M12 16v.01"></path>
          <path d="M11 12.5v.01"></path>
        </svg>
      </div>
      <div>
        <h3 class="text-white font-semibold text-lg mb-1">Privacidad y Cookies</h3>
        <p class="text-gray-400 text-sm leading-relaxed">
          Utilizamos cookies propias y de terceros para mejorar tu experiencia y analizar el tráfico de forma anónima. ¿Aceptas su uso?
        </p>
      </div>
    </div>
    <div class="flex flex-col sm:flex-row gap-3 mt-2">
      <button id="accept-cookies" class="flex-1 px-4 py-2 bg-primary hover:bg-opacity-80 text-white text-sm font-medium rounded-lg transition-colors duration-200">
        Aceptar todas
      </button>
      <button id="reject-cookies" class="flex-1 px-4 py-2 bg-white/5 hover:bg-white/10 text-gray-300 text-sm font-medium rounded-lg border border-white/10 transition-colors duration-200">
        Solo esenciales
      </button>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const banner = document.getElementById('cookie-banner');
    const btnAccept = document.getElementById('accept-cookies');
    const btnReject = document.getElementById('reject-cookies');

    if (!banner || !btnAccept || !btnReject) return;

    // Obtener preferencia previa
    const consent = localStorage.getItem('cookie-consent');
    
    // Función global gtag provista en el <head>
    const w = window as any;
    const gtag = w.gtag || function() { w.dataLayer = w.dataLayer || []; w.dataLayer.push(arguments); };

    if (!consent) {
      // Mostrar banner con animación si no hay decisión
      banner.classList.remove('hidden');
      // Delay ínfimo para aplicar la clase tras remover el hidden (CSS transitions)
      setTimeout(() => {
        banner.classList.remove('translate-y-8', 'opacity-0', 'pointer-events-none');
        banner.classList.add('translate-y-0', 'opacity-100', 'pointer-events-auto');
      }, 50);
    }

    const hideBanner = () => {
      banner.classList.remove('translate-y-0', 'opacity-100', 'pointer-events-auto');
      banner.classList.add('translate-y-8', 'opacity-0', 'pointer-events-none');
      setTimeout(() => banner.classList.add('hidden'), 500); // Esperar que acabe la transición
    };

    const updateConsent = (granted: boolean) => {
      // 1. Guardar en Storage
      localStorage.setItem('cookie-consent', granted ? 'granted' : 'denied');
      
      // 2. Notificar a Google Tag Manager a través de Consent Mode
      gtag('consent', 'update', {
        'analytics_storage': granted ? 'granted' : 'denied',
        'ad_storage': granted ? 'granted' : 'denied',
        'ad_user_data': granted ? 'granted' : 'denied',
        'ad_personalization': granted ? 'granted' : 'denied'
      });
      
      // 3. Ocultar banner
      hideBanner();
    };

    btnAccept.addEventListener('click', () => updateConsent(true));
    btnReject.addEventListener('click', () => updateConsent(false));
  });
</script>
