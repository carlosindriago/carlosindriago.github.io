---
import { projects } from '../data/projects';
---

<section id="projects" class="py-20 md:py-32 bg-background relative overflow-hidden js-reveal">
  <div class="bg-glow top-[40%] left-[-20%] opacity-20"></div>
  <div class="max-w-6xl mx-auto px-6 relative z-10">
    <p class="text-accent-default font-mono text-sm font-semibold mb-3 tracking-widest uppercase">// proyectos</p>
    <h2 class="font-display font-800 text-white mb-16" style="font-size: var(--text-2xl);">
      Casos de impacto técnico
    </h2>

    <div class="flex flex-col gap-16 md:gap-24">
      {projects.map((p, i) => (
        <div class="project-entry flex flex-col">

          {/* ── Project Card ── */}
          <article
            id={`proj-${i}`}
            class={`project-card group relative bg-surface/50 backdrop-blur-md rounded-2xl p-8 border border-white/10 transition-all duration-500 hover:border-brand-500/30 hover:shadow-[0_16px_48px_rgba(37,99,235,0.12)] flex flex-col ${i % 2 === 0 ? 'md:flex-row' : 'md:flex-row-reverse'} gap-10 md:gap-16 md:items-center items-start`}
          >
            <span aria-hidden="true" class="font-display font-800 text-4xl text-white/10 absolute top-6 right-8 pointer-events-none">
              {String(i + 1).padStart(2, '0')}
            </span>

            {/* Text block */}
            <div class={`text-left flex flex-col ${p.image ? 'w-full md:w-1/2' : 'w-full'}`}>
              <h3 class="font-display font-800 text-white mb-6 pr-12" style="font-size: var(--text-lg);">{p.title}</h3>
              <div class="grid gap-4 mb-8">
                {[
                  { label: 'Problema',         text: p.problem  },
                  { label: 'Decisión técnica',  text: p.decision },
                  { label: 'Impacto',           text: p.impact   },
                ].map(item => (
                  <div class="rounded-2xl border border-white/5 bg-white/[0.03] p-4">
                    <p class="font-mono text-[11px] font-bold uppercase tracking-widest text-brand-400 mb-2">{item.label}</p>
                    <p class="text-gray-300 leading-relaxed text-[15px]">{item.text}</p>
                  </div>
                ))}
              </div>
              {!p.image && (
                <div class="flex flex-wrap gap-2 mb-8">
                  {p.tags.map(tag => (
                    <span class="px-3 py-1 rounded-full text-xs font-semibold bg-white/5 border border-white/10 text-gray-300 cursor-default">{tag}</span>
                  ))}
                </div>
              )}
              {p.repo && (
                <div class="flex gap-4 pt-6 border-t border-white/10">
                  <a href={p.repo} aria-label={`Ver repositorio GitHub de ${p.title}`} target="_blank" rel="noopener noreferrer"
                     class="text-sm font-semibold text-brand-400 hover:text-white transition-colors flex items-center gap-1.5">
                    Ver Código en GitHub
                    <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                  </a>
                </div>
              )}
            </div>

            {/* Visual block — only for projects with images */}
            {p.image && (
              <div class="w-full md:w-1/2 flex flex-col items-center justify-center gap-6">
                <button
                  type="button"
                  id={`open-btn-${i}`}
                  aria-label={`Ver galería de ${p.title}`}
                  aria-expanded="false"
                  aria-controls={`viewer-${i}`}
                  data-open-viewer={i}
                  class="open-viewer-btn w-full focus:outline-none focus:ring-2 focus:ring-brand-500 overflow-hidden rounded-xl border border-white/10 bg-white/5 shadow-2xl transition-all duration-300 cursor-zoom-in relative"
                >
                  <div class="open-overlay absolute inset-0 flex items-center justify-center opacity-0 transition-opacity duration-300 bg-black/50 z-10 rounded-xl">
                    <span class="flex items-center gap-2 text-white text-sm font-semibold">
                      <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
                      Ver galería
                    </span>
                  </div>
                  <img
                    src={p.image}
                    alt={`Vista principal de ${p.title}`}
                    loading="lazy"
                    width={p.imageWidth || 1024}
                    height={p.imageHeight || 787}
                    class="card-thumb w-full h-auto object-contain rounded-xl transition-transform duration-500"
                  />
                </button>
                <div class="flex flex-wrap gap-2 w-full justify-start">
                  {p.tags.map(tag => (
                    <span class="px-3 py-1 rounded-full text-xs font-semibold bg-white/5 border border-white/10 text-gray-300 hover:border-brand-500/30 hover:bg-brand-500/5 hover:text-white transition-all duration-300 cursor-default">{tag}</span>
                  ))}
                </div>
              </div>
            )}
          </article>

          {/* ── Inline Viewer (expands below the card) ── */}
          {p.image && (
            <div
              id={`viewer-${i}`}
              class="project-viewer"
              role="region"
              aria-label={`Galería de ${p.title}`}
              aria-hidden="true"
            >
              <div class="viewer-clip">
                <div class="viewer-body">

                  {/* Left: image display */}
                  <div class="viewer-img-side">
                    {p.gallery && p.gallery.length > 1 && (
                      <button type="button" class="vnav vprev" data-dir="-1" aria-label="Imagen anterior">
                        <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path d="M15 19l-7-7 7-7"/></svg>
                      </button>
                    )}

                    <img
                      id={`vimg-${i}`}
                      src={p.gallery?.[0]?.src ?? p.image}
                      alt={p.gallery?.[0]?.alt ?? p.title}
                      class="vmain-img"
                    />

                    {p.gallery && p.gallery.length > 1 && (
                      <button type="button" class="vnav vnext" data-dir="1" aria-label="Siguiente imagen">
                        <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg>
                      </button>
                    )}

                    {p.gallery && p.gallery.length > 1 && (
                      <div class="vstrip" role="list" aria-label="Miniaturas de galería">
                        {p.gallery.map((item, j) => (
                          <button
                            type="button"
                            role="listitem"
                            class={`vthumb ${j === 0 ? 'is-active' : ''}`}
                            data-idx={j}
                            data-src={item.src}
                            data-alt={item.alt}
                            data-desc={item.technicalDescription}
                            aria-label={item.alt}
                            aria-pressed={j === 0 ? 'true' : 'false'}
                          >
                            <img src={item.src} alt={item.alt} loading="lazy" />
                          </button>
                        ))}
                      </div>
                    )}
                  </div>

                  {/* Right: info panel */}
                  <div class="viewer-info-side">
                    <button type="button" class="vclose" aria-label="Cerrar visor">
                      <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" d="M6 18L18 6M6 6l12 12"/></svg>
                    </button>

                    <p class="veyebrow">// galería</p>
                    <h4 class="vtitle">{p.title}</h4>
                    <p id={`vcap-${i}`} class="vcaption">{p.gallery?.[0]?.alt ?? ''}</p>
                    <hr class="vsep" />
                    <p id={`vdesc-${i}`} class="vdesc">{p.gallery?.[0]?.technicalDescription ?? ''}</p>

                    <div class="vfooter">
                      <span class="vhint">← → navegar · ESC cerrar</span>
                      {p.gallery && p.gallery.length > 1 && (
                        <span id={`vcnt-${i}`} class="vcounter">1 / {p.gallery.length}</span>
                      )}
                    </div>
                  </div>

                </div>
              </div>
            </div>
          )}

        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* ====== In-page Project Viewer ====== */

  /*
   * grid-template-rows: 0fr → 1fr is the modern, JS-free way to animate
   * height from 0 to auto without layout reflow.
   * The inner element must have overflow:hidden for the clip to work.
   */
  .project-viewer {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.55s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .project-viewer.is-open {
    grid-template-rows: 1fr;
  }

  .viewer-clip {
    overflow: hidden;
    /* min-height:0 ensures grid-template-rows: 0fr actually collapses to 0 */
    min-height: 0;
  }

  .viewer-body {
    display: flex;
    flex-direction: column;
    margin-top: 0.5rem;
    border-radius: 1rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-top: 2px solid rgba(37, 99, 235, 0.5);
    background: #181b20;
    overflow: hidden;
    opacity: 0;
    transform: translateY(-8px);
    transition: opacity 0.35s ease 0.12s, transform 0.35s ease 0.12s;
  }

  .project-viewer.is-open .viewer-body {
    opacity: 1;
    transform: translateY(0);
  }

  @media (min-width: 768px) {
    .viewer-body {
      flex-direction: row;
      height: 72vh;
      max-height: 640px;
    }
  }

  /* === Image side === */
  .viewer-img-side {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #000;
    flex: 1;
    min-height: 260px;
    overflow: hidden;
  }

  @media (min-width: 768px) {
    .viewer-img-side {
      flex: none;
      width: 62%;
      min-height: unset;
    }
  }

  .vmain-img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    padding: 1.25rem;
    transition: opacity 0.18s ease;
    /* Reserve space for thumbnails strip */
    padding-bottom: 4rem;
  }

  .vmain-img.fading { opacity: 0; }

  /* Thumbnail strip */
  .vstrip {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    display: flex;
    gap: 0.5rem;
    padding: 0.75rem 1rem;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.85) 0%, transparent 100%);
    overflow-x: auto;
    scrollbar-width: none;
  }
  .vstrip::-webkit-scrollbar { display: none; }

  .vthumb {
    flex-shrink: 0;
    width: 3.5rem;
    height: 2.25rem;
    border-radius: 0.375rem;
    overflow: hidden;
    border: 2px solid rgba(255, 255, 255, 0.12);
    cursor: pointer;
    transition: border-color 0.2s, transform 0.2s;
    line-height: 0;
  }
  .vthumb:hover { border-color: rgba(255,255,255,0.4); transform: scale(1.08); }
  .vthumb.is-active { border-color: #3b82f6; }
  .vthumb img { width: 100%; height: 100%; object-fit: cover; display: block; }

  /* Prev / Next */
  .vnav {
    position: absolute;
    top: calc(50% - 2rem); /* offset upward to clear thumbnail strip */
    transform: translateY(-50%);
    background: rgba(255,255,255,0.07);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 9999px;
    padding: 0.625rem;
    color: rgba(255,255,255,0.65);
    cursor: pointer;
    z-index: 10;
    transition: all 0.2s;
    line-height: 0;
  }
  .vnav:hover { background: rgba(255,255,255,0.14); color: #fff; transform: translateY(-50%) scale(1.08); }
  .vprev { left: 0.75rem; }
  .vnext { right: 0.75rem; }

  /* === Info side === */
  .viewer-info-side {
    display: flex;
    flex-direction: column;
    padding: 1.75rem;
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: rgba(255,255,255,0.08) transparent;
    background: #181b20;
    border-top: 1px solid rgba(255,255,255,0.05);
    position: relative;
    min-height: 200px;
  }

  @media (min-width: 768px) {
    .viewer-info-side {
      flex: none;
      width: 38%;
      border-top: none;
      border-left: 1px solid rgba(255,255,255,0.05);
      max-height: 100%;
    }
  }

  .vclose {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 9999px;
    padding: 0.5rem;
    color: rgba(255,255,255,0.5);
    cursor: pointer;
    line-height: 0;
    transition: all 0.2s;
  }
  .vclose:hover { background: rgba(255,255,255,0.1); color: #fff; border-color: rgba(255,255,255,0.25); }

  .veyebrow {
    font-size: 0.6875rem;
    font-family: monospace;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #60a5fa;
    margin-bottom: 0.5rem;
  }

  .vtitle {
    font-size: 1rem;
    font-weight: 700;
    color: #fff;
    line-height: 1.3;
    padding-right: 2.25rem;
    margin-bottom: 0.5rem;
  }

  .vcaption {
    font-size: 0.6875rem;
    font-family: monospace;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #a78bfa;
    margin-bottom: 1rem;
    min-height: 1em; /* prevent layout shift during image switch */
  }

  .vsep {
    border: none;
    border-top: 1px solid rgba(255,255,255,0.06);
    margin-bottom: 1rem;
  }

  .vdesc {
    font-size: 0.8125rem;
    color: #d1d5db;
    line-height: 1.75;
    flex: 1;
    min-height: 3em;
  }

  .vfooter {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(255,255,255,0.05);
    font-size: 0.625rem;
    font-family: monospace;
    color: #4b5563;
  }

  .vhint { display: none; }
  @media (min-width: 768px) { .vhint { display: block; } }

  /* Card image button: show overlay on hover */
  .open-viewer-btn:hover .open-overlay { opacity: 1; }
  .open-viewer-btn:hover .card-thumb { transform: scale(1.02); }

  /* Card active state while viewer is open */
  .project-card.viewer-active {
    border-color: rgba(37, 99, 235, 0.45) !important;
    box-shadow: 0 0 0 1px rgba(37, 99, 235, 0.15), 0 16px 48px rgba(37, 99, 235, 0.12) !important;
  }
</style>

<script>
  let openIdx  = -1;
  let currImg  = 0;
  let ctrl: AbortController | null = null;

  // --- DOM helpers ---
  const card   = (i: number) => document.getElementById(`proj-${i}`);
  const viewer = (i: number) => document.getElementById(`viewer-${i}`);
  const vimg   = (i: number) => document.getElementById(`vimg-${i}`) as HTMLImageElement | null;

  function updateImage(projIdx: number, imgIdx: number) {
    const thumbs = Array.from(
      document.querySelectorAll<HTMLElement>(`#viewer-${projIdx} .vthumb`)
    );

    if (thumbs.length === 0) return; // single-image project, nothing to switch

    const thumb = thumbs[imgIdx];
    if (!thumb) return;

    const src  = thumb.dataset.src  ?? '';
    const alt  = thumb.dataset.alt  ?? '';
    const desc = thumb.dataset.desc ?? '';

    const img = vimg(projIdx);
    if (img && img.src !== src) {
      img.classList.add('fading');
      setTimeout(() => {
        img.src = src;
        img.alt = alt;
        const done = () => img.classList.remove('fading');
        img.complete ? done() : img.addEventListener('load', done, { once: true });
      }, 180);
    }

    const capEl  = document.getElementById(`vcap-${projIdx}`);
    const descEl = document.getElementById(`vdesc-${projIdx}`);
    const cntEl  = document.getElementById(`vcnt-${projIdx}`);

    if (capEl)  capEl.textContent  = alt;
    if (descEl) descEl.textContent = desc;
    if (cntEl)  cntEl.textContent  = `${imgIdx + 1} / ${thumbs.length}`;

    thumbs.forEach((t, j) => {
      t.classList.toggle('is-active', j === imgIdx);
      t.setAttribute('aria-pressed', String(j === imgIdx));
    });

    currImg = imgIdx;
  }

  function openViewer(projIdx: number) {
    // Close any other open viewer first
    if (openIdx !== -1 && openIdx !== projIdx) _doClose(openIdx, false);

    openIdx = projIdx;

    updateImage(projIdx, 0);

    viewer(projIdx)?.classList.add('is-open');
    viewer(projIdx)?.setAttribute('aria-hidden', 'false');
    card(projIdx)?.classList.add('viewer-active');
    document.getElementById(`open-btn-${projIdx}`)?.setAttribute('aria-expanded', 'true');

    // Scroll the viewer into view once the animation starts
    setTimeout(() => viewer(projIdx)?.scrollIntoView({ behavior: 'smooth', block: 'nearest' }), 80);
  }

  function _doClose(projIdx: number, scrollBack: boolean) {
    viewer(projIdx)?.classList.remove('is-open');
    viewer(projIdx)?.setAttribute('aria-hidden', 'true');
    card(projIdx)?.classList.remove('viewer-active');
    document.getElementById(`open-btn-${projIdx}`)?.setAttribute('aria-expanded', 'false');

    if (scrollBack) {
      setTimeout(() => card(projIdx)?.scrollIntoView({ behavior: 'smooth', block: 'nearest' }), 80);
    }
  }

  function closeViewer() {
    if (openIdx === -1) return;
    _doClose(openIdx, true);
    openIdx = -1;
    currImg = 0;
  }

  function navigate(dir: 1 | -1) {
    if (openIdx === -1) return;
    const total = document.querySelectorAll(`#viewer-${openIdx} .vthumb`).length;
    if (total < 2) return;
    updateImage(openIdx, (currImg + dir + total) % total);
  }

  // --- Init (re-runs on every astro:page-load) ---
  function initViewer() {
    ctrl?.abort();
    ctrl = new AbortController();
    const { signal } = ctrl;

    document.addEventListener('click', (e) => {
      const el = e.target as Element;

      // Card image → open/toggle viewer
      const openBtn = el.closest<HTMLElement>('[data-open-viewer]');
      if (openBtn) {
        const idx = parseInt(openBtn.dataset.openViewer ?? '-1', 10);
        if (idx === -1) return;
        openIdx === idx ? closeViewer() : openViewer(idx);
        return;
      }

      // Close button inside viewer
      if (el.closest('.vclose')) { closeViewer(); return; }

      // Thumbnail click
      const thumb = el.closest<HTMLElement>('.vthumb[data-idx]');
      if (thumb) {
        // find which viewer this thumb belongs to
        const viewerEl = thumb.closest<HTMLElement>('[id^="viewer-"]');
        if (!viewerEl) return;
        const pIdx = parseInt(viewerEl.id.replace('viewer-', ''), 10);
        const iIdx = parseInt(thumb.dataset.idx ?? '0', 10);
        updateImage(pIdx, iIdx);
        return;
      }

      // Prev/Next nav
      const navBtn = el.closest<HTMLElement>('.vnav[data-dir]');
      if (navBtn) {
        navigate(parseInt(navBtn.dataset.dir ?? '1', 10) as 1 | -1);
        return;
      }
    }, { signal });

    // Keyboard
    document.addEventListener('keydown', (e) => {
      if (openIdx === -1) return;
      if (e.key === 'Escape')     closeViewer();
      if (e.key === 'ArrowRight') navigate(1);
      if (e.key === 'ArrowLeft')  navigate(-1);
    }, { signal });
  }

  document.addEventListener('astro:page-load', initViewer);
</script>
